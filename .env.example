# Hypha environment. Copy to .env (gitignored) and fill in.

# M1 — local ledger path
HYPHA_DB_PATH=./hypha.db

# M1 (optional) — Telegram surface. Leave unset to run CLI-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# M4 — model router keys. Unset any provider you don't use.
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# M4 — event bus. Leave unset for local in-process bus during early milestones.
REDIS_URL=
